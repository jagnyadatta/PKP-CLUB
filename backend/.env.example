# Backend Environment Variables (.env.example)
# Duplicate this file as .env in the backend folder and populate with actual credentials.

# Application Port (Render / Hosting automatically supplies PORT)
PORT=8080
NODE_ENV=production

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pkp_club?retryWrites=true&w=majority

# JWT Secret for Session & Admin Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Storage Configuration (for photo/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Deployed URLs (comma-separated for CORS allowance)
FRONTEND_URL=https://pkp-club.vercel.app,http://localhost:5173

# Feature Flags
REGISTRATION_ENABLED=false
